{
  "name": "chorraha-boshqaruvi",
  "version": "0.1.0",
  "description": "Traffic Puzzle — izometrik chorraha boshqaruvi o'yini (engine + prototip)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "serve": "node -e \"import('http').then(h=>import('fs').then(f=>import('path').then(p=>h.createServer((q,s)=>{let u=q.url==='/'?'/index.html':q.url;let fp=p.join(process.cwd(),u.split('?')[0]);f.readFile(fp,(e,d)=>{if(e){s.writeCode?0:0;s.writeHead(404);return s.end('404')}const t={'.html':'text/html','.js':'text/javascript','.css':'text/css','.map':'application/json'}[p.extname(fp)]||'text/plain';s.writeHead(200,{'Content-Type':t});s.end(d)})}).listen(8080,()=>console.log('http://localhost:8080')))))\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node tests/engine.test.mjs"
  },
  "keywords": ["game", "traffic", "puzzle", "isometric", "typescript"],
  "license": "MIT"
}
